<Defs>
  
  <HediffDef>
    <defName>LE_LendReturnHediff_Sore</defName>
    <label>任务后的酸痛</label>
    <description>长时间的奔波与紧张让身体仍有些酸痛，需要休息一段时间。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <maxSeverity>6</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>120000~180000</disappearsAfterTicks>
      </li>
    </comps>
    <stages>
      <li>
        <painOffset>0.06</painOffset>
        <statOffsets>
          <MoveSpeed>-0.10</MoveSpeed>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>
